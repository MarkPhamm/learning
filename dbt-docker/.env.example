# Copy to .env and fill in. .env is gitignored.
# The private key itself lives in .ssh/ and is mounted at /root/.ssh in the container.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_PRIVATE_KEY_PATH=/root/.ssh/snowflake_key.p8
SNOWFLAKE_WAREHOUSE=transforming
SNOWFLAKE_DATABASE=analytics
SNOWFLAKE_SCHEMA=dbt

# Only if your key is encrypted with a passphrase
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
